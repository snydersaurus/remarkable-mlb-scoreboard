# Per-app OpenSSL config for the scoreboard. Point OPENSSL_CONF at this file.
#
# The device ships /etc/ssl/openssl.cnf.d/10-reduce-tls-ciphers.cnf, which cuts
# the TLS 1.2 cipher list down to ECDHE-ECDSA suites only (SOG-IS v1.3, for
# EU-RED certification). statsapi.mlb.com serves an RSA certificate and does
# not speak TLS 1.3, so it needs ECDHE-RSA -- there is no overlap, and the
# handshake dies with "tls alert handshake failure".
#
# This is the system list plus the three forward-secret AEAD suites for RSA
# certificates, for this process only. It does not touch system-wide TLS
# policy, keeps the TLS 1.2 floor and the TLS 1.3 suites, and still excludes
# CBC suites and anything without forward secrecy (which Ciphersuites = TLS_AES_256_GCM_SHA384:TLS_AES_128_GCM_SHA256:TLS_AES_128_CCM_SHA256
CipherString = ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-CCM:ECDHE-ECDSA-AES128-CCM:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-CHACHA20-POLY1305
# would admit). The cipher actually negotiated is ECDHE-RSA-AES128-GCM-SHA256.
openssl_conf = openssl_init

[ openssl_init ]
ssl_conf = ssl_configuration

[ ssl_configuration ]
system_default = system_default_tls

[ system_default_tls ]
MinProtocol = TLSv1.2
Ciphersuites = TLS_AES_256_GCM_SHA384:TLS_AES_128_GCM_SHA256:TLS_AES_128_CCM_SHA256
CipherString = ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-CCM:ECDHE-ECDSA-AES128-CCM:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-CHACHA20-POLY1305
